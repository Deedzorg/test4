# Optional runtime hints for the Infrastry Gauntlet.
# The application has safe defaults and can start without any user-supplied values here.

GAUNTLET_SENTINEL=infrastry-found-me
DATA_DIR=.data
REQUIRE_DATABASE=false
DATABASE_URL=

# Chaos/recovery controls are intentionally omitted from this example because
# they are disabled by default in code. GAUNTLET_ADMIN_KEY is only required
# when CHAOS_ENABLED=true is explicitly enabled for a controlled recovery test.
